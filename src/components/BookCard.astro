---
const { book } = Astro.props;
---

<a class="book-card" href={`/books/${book.slug}`}>
  <div class="cover">
    <img src={book.cover} alt={book.title} />
  </div>

  <div class="content">
    <span class="category">{book.category}</span>
    <h3>{book.title}</h3>
    <p>{book.author}</p>
    <strong>${book.price}</strong>
  </div>
</a>

<style>
  .book-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border: 1px solid #e5e5e5;
    border-radius: 14px;
    overflow: hidden;
    background: white;
    transition: transform 0.2s ease;
  }

  .book-card:hover {
    transform: translateY(-4px);
  }

  .cover {
    aspect-ratio: 3 / 4;
    background: #f4f4f4;
    overflow: hidden;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .content {
    padding: 16px;
  }

  .category {
    font-size: 12px;
    color: #777;
  }

  h3 {
    margin: 8px 0 4px;
  }

  p {
    margin: 0 0 10px;
    color: #666;
  }

  strong {
    font-size: 18px;
  }
</style>