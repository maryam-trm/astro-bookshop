<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Books | Little Leaf Books</title>
  </head>

  <body>
    <main>
      <section class="header">
        <p class="eyebrow">OUR COLLECTION</p>
        <h1>Books for curious readers</h1>
        <p>
          Explore stories, activities, and educational books for different ages.
        </p>
      </section>

      <section id="books-grid" class="grid">
        <p>Loading books...</p>
      </section>
    </main>

    <script>
      interface Book {
        slug: string;
        title: string;
        author: string;
        category: string;
        price: number;
        cover: string;
      }

      async function loadBooks() {
        const grid = document.getElementById("books-grid");

        if (!grid) return;

        try {
          const response = await fetch("/api/books");

          if (!response.ok) {
            throw new Error(`API returned ${response.status}`);
          }

          const books: Book[] = await response.json();

          grid.innerHTML = books
            .map(
              (book) => `
                <a class="book-card" href="/books/${book.slug}">
                  <div class="cover">
                    <img src="${book.cover}" alt="${book.title}" />
                  </div>

                  <div class="content">
                    <span class="category">${book.category}</span>
                    <h3>${book.title}</h3>
                    <p>${book.author}</p>
                    <strong>$${book.price}</strong>
                  </div>
                </a>
              `
            )
            .join("");
        } catch (error) {
          console.error(error);
          grid.innerHTML = "<p>Could not load books from the API.</p>";
        }
      }

      loadBooks();
    </script>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #faf8f4;
    color: #222;
  }

  main {
    max-width: 1200px;
    margin: auto;
    padding: 60px 24px;
  }

  .header {
    margin-bottom: 40px;
  }

  .eyebrow {
    font-size: 13px;
    letter-spacing: 2px;
    color: #777;
  }

  h1 {
    font-size: 42px;
    margin: 8px 0 12px;
  }

  .header > p:last-child {
    color: #666;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  :global(.book-card) {
    display: block;
    text-decoration: none;
    color: inherit;
    border: 1px solid #e5e5e5;
    border-radius: 14px;
    overflow: hidden;
    background: white;
    transition: transform 0.2s ease;
  }

  :global(.book-card:hover) {
    transform: translateY(-4px);
  }

  :global(.cover) {
    aspect-ratio: 3 / 4;
    background: #eee;
    overflow: hidden;
  }

  :global(.cover img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.content) {
    padding: 16px;
  }

  :global(.category) {
    font-size: 12px;
    color: #777;
  }

  :global(.content h3) {
    margin: 8px 0 4px;
  }

  :global(.content p) {
    color: #666;
  }

  @media (max-width: 800px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>