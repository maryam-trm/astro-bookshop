---
import BookCard from "../components/BookCard.astro";
import { books } from "../data/books";

const featuredBooks = books.slice(0, 3);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Astro Bookshop</title>
  </head>

  <body>
    <header>
      <nav>
        <a class="logo" href="/">Little Leaf Books</a>

        <div class="links">
          <a href="/">Home</a>
          <a href="/books">Books</a>
          <a href="#categories">Categories</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div>
          <p class="eyebrow">BOOKS FOR YOUNG READERS</p>
          <h1>Stories that inspire every young reader.</h1>
          <p class="hero-text">
            Discover books that encourage curiosity, imagination, and learning.
          </p>

          <a class="button" href="/books">Explore Books</a>
        </div>
      </section>

      <section class="section">
        <div class="section-title">
          <div>
            <p class="eyebrow">FEATURED</p>
            <h2>Popular books</h2>
          </div>

          <a href="/books">View all books →</a>
        </div>

        <div class="book-grid">
          {featuredBooks.map((book) => <BookCard book={book} />)}
        </div>
      </section>

      <section id="categories" class="section">
        <p class="eyebrow">EXPLORE</p>
        <h2>Browse by category</h2>

        <div class="categories">
          <a href="/books">Adventure</a>
          <a href="/books">Educational</a>
          <a href="/books">Bedtime</a>
          <a href="/books">Activities</a>
        </div>
      </section>

      <section class="personalized">
        <div>
          <p class="eyebrow">MAKE IT SPECIAL</p>
          <h2>A book made just for them</h2>
          <p>
            Turn reading time into something personal with a story inspired by
            your child's name and imagination.
          </p>

          <a class="button" href="/books">Discover Personalized Books</a>
        </div>
      </section>

      <section class="section">
        <p class="eyebrow">FROM OUR BLOG</p>
        <h2>Reading tips</h2>

        <div class="blog-grid">
          <article>
            <h3>How to make reading fun for kids</h3>
            <p>Simple ways to turn daily reading into an activity children enjoy.</p>
          </article>

          <article>
            <h3>Choosing books for different ages</h3>
            <p>What to look for when picking stories for growing readers.</p>
          </article>

          <article>
            <h3>Building a small home library</h3>
            <p>Create a reading corner that encourages curiosity and exploration.</p>
          </article>
        </div>
      </section>
    </main>

    <footer>
      <strong>Little Leaf Books</strong>
      <p>Stories for curious minds.</p>
    </footer>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #faf8f4;
    color: #222;
  }

  header {
    background: white;
    border-bottom: 1px solid #eee;
  }

  nav {
    max-width: 1200px;
    margin: auto;
    padding: 20px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .logo {
    font-weight: bold;
    font-size: 20px;
  }

  .links {
    display: flex;
    gap: 24px;
  }

  .hero {
    min-height: 520px;
    display: flex;
    align-items: center;
    max-width: 1200px;
    margin: auto;
    padding: 70px 24px;
  }

  .hero > div {
    max-width: 650px;
  }

  h1 {
    font-size: 64px;
    line-height: 1.05;
    margin: 12px 0 20px;
  }

  h2 {
    font-size: 36px;
    margin: 8px 0 28px;
  }

  .hero-text {
    font-size: 20px;
    color: #666;
    margin-bottom: 32px;
  }

  .eyebrow {
    font-size: 13px;
    letter-spacing: 2px;
    color: #777;
  }

  .button {
    display: inline-block;
    background: #222;
    color: white;
    padding: 14px 22px;
    border-radius: 8px;
  }

  .section {
    max-width: 1200px;
    margin: auto;
    padding: 70px 24px;
  }

  .section-title {
    display: flex;
    justify-content: space-between;
    align-items: end;
  }

  .book-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .categories {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .categories a {
    background: white;
    padding: 40px 20px;
    border-radius: 14px;
    text-align: center;
    font-weight: bold;
  }

  .personalized {
    max-width: 1150px;
    margin: 40px auto;
    padding: 70px;
    border-radius: 20px;
    background: #eee7dc;
  }

  .personalized > div {
    max-width: 600px;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  article {
    padding: 24px;
    background: white;
    border-radius: 14px;
  }

  footer {
    text-align: center;
    padding: 50px 24px;
    background: #222;
    color: white;
  }

  @media (max-width: 800px) {
    h1 {
      font-size: 44px;
    }

    .book-grid,
    .blog-grid {
      grid-template-columns: 1fr;
    }

    .categories {
      grid-template-columns: repeat(2, 1fr);
    }

    .links {
      gap: 12px;
      font-size: 14px;
    }
  }
</style>